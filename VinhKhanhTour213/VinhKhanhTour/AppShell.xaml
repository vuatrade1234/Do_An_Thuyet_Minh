<?xml version="1.0" encoding="utf-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:VinhKhanhTour.Views"
       x:Class="VinhKhanhTour.AppShell"
       Shell.TabBarBackgroundColor="#1A237E"
       Shell.TabBarForegroundColor="White"
       Shell.TabBarTitleColor="White"
       Shell.TabBarUnselectedColor="#9FA8DA">

    <TabBar>
        <ShellContent x:Name="TabMap"
                      Title="Bản đồ"
                      Route="MapPage"
                      ContentTemplate="{DataTemplate views:MapPage}"/>
        <ShellContent x:Name="TabList"
                      Title="Danh sách"
                      Route="PoiListPage"
                      ContentTemplate="{DataTemplate views:PoiListPage}"/>
        <ShellContent x:Name="TabSettings"
                      Title="Cài đặt"
                      Route="SettingsPage"
                      ContentTemplate="{DataTemplate views:SettingsPage}"/>
    </TabBar>

</Shell>