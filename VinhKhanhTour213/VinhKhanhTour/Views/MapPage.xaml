<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VinhKhanhTour.Views.MapPage"
             Title="🍜 Phố Vĩnh Khánh"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">

        <!-- Header -->
        <Grid Grid.Row="0" BackgroundColor="#1A237E" Padding="10,8"
              ColumnDefinitions="*,Auto,Auto">
            <Label Grid.Column="0" Text="{Binding StatusText}"
                   TextColor="White" FontSize="12" VerticalOptions="Center"
                   LineBreakMode="TailTruncation"/>
            <Button Grid.Column="1"
                    x:Name="BtnLangHeader"
                    Text="{Binding SelectedLanguage}"
                    Clicked="OnToggleLanguageClicked"
                    BackgroundColor="#DA251D"
                    TextColor="White"
                    FontSize="11" Padding="8,4" Margin="4,0" CornerRadius="6"/>
            <Button Grid.Column="2"
                    Text="{Binding StartStopText}"
                    Clicked="OnStartClicked"
                    BackgroundColor="#283593" TextColor="White"
                    FontSize="11" Padding="8,4" CornerRadius="6"/>
        </Grid>

        <Grid Grid.Row="1">

            <!-- Map WebView -->
            <WebView x:Name="MapWebView"
                     Navigated="OnMapNavigated"
                     Navigating="OnWebViewNavigating"/>

            <!-- D-pad góc trái dưới -->
            <Grid WidthRequest="126" HeightRequest="126"
                  HorizontalOptions="Start" VerticalOptions="End"
                  Margin="12,0,0,160"
                  RowDefinitions="40,40,40"
                  ColumnDefinitions="40,40,40"
                  RowSpacing="3" ColumnSpacing="3">
                <Button Grid.Row="0" Grid.Column="1" Text="▲"
                        FontSize="15" CornerRadius="8" Padding="0"
                        BackgroundColor="#CC1A237E" TextColor="White"
                        HeightRequest="40" WidthRequest="40"
                        Clicked="OnMoveUp"/>
                <Button Grid.Row="1" Grid.Column="0" Text="◀"
                        FontSize="15" CornerRadius="8" Padding="0"
                        BackgroundColor="#CC1A237E" TextColor="White"
                        HeightRequest="40" WidthRequest="40"
                        Clicked="OnMoveLeft"/>
                <Button Grid.Row="1" Grid.Column="1" Text="●"
                        FontSize="13" CornerRadius="20" Padding="0"
                        BackgroundColor="#CC283593" TextColor="White"
                        HeightRequest="40" WidthRequest="40"
                        Clicked="OnMoveReset"/>
                <Button Grid.Row="1" Grid.Column="2" Text="▶"
                        FontSize="15" CornerRadius="8" Padding="0"
                        BackgroundColor="#CC1A237E" TextColor="White"
                        HeightRequest="40" WidthRequest="40"
                        Clicked="OnMoveRight"/>
                <Button Grid.Row="2" Grid.Column="1" Text="▼"
                        FontSize="15" CornerRadius="8" Padding="0"
                        BackgroundColor="#CC1A237E" TextColor="White"
                        HeightRequest="40" WidthRequest="40"
                        Clicked="OnMoveDown"/>
            </Grid>

            <!-- Zoom + My Location góc phải dưới -->
            <VerticalStackLayout HorizontalOptions="End" VerticalOptions="End"
                                 Margin="0,0,12,160" Spacing="8">
                <Button Text="＋" Clicked="OnZoomInClicked"
                        WidthRequest="44" HeightRequest="44"
                        CornerRadius="22" BackgroundColor="White"
                        TextColor="#1A237E" FontSize="22" Padding="0">
                    <Button.Shadow>
                        <Shadow Brush="Black" Opacity="0.2" Radius="6"/>
                    </Button.Shadow>
                </Button>
                <Button Text="－" Clicked="OnZoomOutClicked"
                        WidthRequest="44" HeightRequest="44"
                        CornerRadius="22" BackgroundColor="White"
                        TextColor="#1A237E" FontSize="22" Padding="0">
                    <Button.Shadow>
                        <Shadow Brush="Black" Opacity="0.2" Radius="6"/>
                    </Button.Shadow>
                </Button>
                <Button Text="🎯" Clicked="OnMyLocationClicked"
                        WidthRequest="48" HeightRequest="48"
                        CornerRadius="24" BackgroundColor="#1A237E"
                        TextColor="White" FontSize="22" Padding="0">
                    <Button.Shadow>
                        <Shadow Brush="Black" Opacity="0.3" Radius="8"/>
                    </Button.Shadow>
                </Button>
            </VerticalStackLayout>

            <!-- Bottom Panel -->
            <Border VerticalOptions="End" HorizontalOptions="Fill"
                    Margin="12,0,12,12" BackgroundColor="White"
                    StrokeThickness="0">
                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.2" Radius="10"/>
                </Border.Shadow>
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16"/>
                </Border.StrokeShape>

                <VerticalStackLayout Padding="12,10" Spacing="8">

                    <!-- Nút huỷ chỉ đường -->
                    <Button x:Name="CancelRouteBtn"
                            Text="✕  Huỷ chỉ đường"
                            Clicked="OnCancelRouteClicked"
                            BackgroundColor="#FFEBEE" TextColor="#C62828"
                            FontSize="13" FontAttributes="Bold"
                            HeightRequest="40" CornerRadius="10"
                            IsVisible="False">
                        <Button.Shadow>
                            <Shadow Brush="Black" Opacity="0.08" Radius="3"/>
                        </Button.Shadow>
                    </Button>

                    <!-- Banner không có POI -->
                    <Border x:Name="NoPOIBanner"
                            BackgroundColor="#FFF3E0" Padding="10,8"
                            StrokeThickness="0" IsVisible="True">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>
                        <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                            <Label Text="📡" FontSize="15" VerticalOptions="Center"/>
                            <Label x:Name="LblNoPoi"
                                   Text="Chưa có điểm nào trong bán kính"
                                   FontSize="13" TextColor="#E65100"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Border>

                    <!-- POI info panel -->
                    <Grid x:Name="PoiInfoGrid"
                          ColumnDefinitions="Auto,*,Auto,Auto"
                          IsVisible="False">

                        <Border Grid.Column="0" BackgroundColor="#E8EAF6"
                                WidthRequest="46" HeightRequest="46"
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Label Text="{Binding SelectedPoiEmoji}" FontSize="22"
                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Margin="10,0"
                                             VerticalOptions="Center">
                            <Label Text="{Binding SelectedPoi.LocalizedName}"
                                   FontAttributes="Bold" FontSize="14"
                                   TextColor="#1A237E"
                                   LineBreakMode="TailTruncation"/>
                            <Label Text="{Binding SelectedPoi.DistanceText}"
                                   FontSize="12" TextColor="#757575"/>
                        </VerticalStackLayout>

                        <Button Grid.Column="2" Text="🧭"
                                Clicked="OnDirectionClicked"
                                BackgroundColor="#E8EAF6" TextColor="#1A237E"
                                FontSize="18" WidthRequest="44" HeightRequest="44"
                                CornerRadius="22" Padding="0" Margin="4,0"/>

                        <Button Grid.Column="3" Text="›"
                                Clicked="OnPoiDetailClicked"
                                BackgroundColor="#1A237E" TextColor="White"
                                FontSize="22" WidthRequest="44" HeightRequest="44"
                                CornerRadius="22" Padding="0"/>
                    </Grid>

                    <!-- Index POI -->
                    <Label x:Name="PoiIndexLabel"
                           Text="{Binding PoiIndexText}"
                           HorizontalOptions="Center"
                           FontSize="11" TextColor="#AAA"
                           IsVisible="False"/>

                </VerticalStackLayout>
            </Border>

        </Grid>
    </Grid>
</ContentPage>
