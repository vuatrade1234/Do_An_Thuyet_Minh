<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VinhKhanhTour.Views.PoiListPage"
             BackgroundColor="#F0F4FF"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <!-- Header -->
        <Grid Grid.Row="0" BackgroundColor="#1A237E" Padding="16,14">
            <Label x:Name="LblListTitle"
                   Text="📋 Danh sách điểm tham quan"
                   TextColor="White" FontSize="16" FontAttributes="Bold"
                   HorizontalOptions="Center"/>
        </Grid>

        <!-- Thanh tìm kiếm -->
        <Border Grid.Row="1" BackgroundColor="White"
                Margin="12,10,12,0" Padding="12,8" StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="14"/>
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="Black" Opacity="0.1" Radius="6"/>
            </Border.Shadow>
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Label Grid.Column="0" Text="🔍" FontSize="18"
                       VerticalOptions="Center" Margin="0,0,8,0"/>
                <Entry Grid.Column="1" x:Name="SearchEntry"
                       Placeholder="Tìm điểm tham quan..."
                       FontSize="14" BackgroundColor="Transparent"
                       TextChanged="OnSearchTextChanged"/>
                <Button Grid.Column="2" Text="✕" x:Name="ClearBtn"
                        IsVisible="False"
                        BackgroundColor="Transparent" TextColor="#999"
                        FontSize="16" Padding="4,0"
                        Clicked="OnClearSearch"/>
            </Grid>
        </Border>

        <!-- Gợi ý tìm kiếm -->
        <Border Grid.Row="2" x:Name="SuggestionPanel"
                IsVisible="False" BackgroundColor="White"
                Margin="12,4,12,0" Padding="0,4" StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10"/>
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="Black" Opacity="0.1" Radius="4"/>
            </Border.Shadow>
            <CollectionView x:Name="SuggestionList" MaximumHeightRequest="200">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="14,10" ColumnDefinitions="Auto,*">
                            <Label Grid.Column="0" Text="{Binding CategoryEmoji}"
                                   FontSize="18" VerticalOptions="Center"/>
                            <VerticalStackLayout Grid.Column="1" Margin="10,0">
                                <Label Text="{Binding LocalizedName}"
                                       FontSize="13" FontAttributes="Bold"
                                       TextColor="#1A237E"/>
                                <Label Text="{Binding LocalizedDescription}"
                                       FontSize="11" TextColor="#888"
                                       MaxLines="1"
                                       LineBreakMode="TailTruncation"/>
                            </VerticalStackLayout>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSuggestionTapped"
                                                      CommandParameter="{Binding .}"/>
                            </Grid.GestureRecognizers>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Border>

        <!-- Danh sách POI -->
        <CollectionView Grid.Row="3" x:Name="PoiList" Margin="12,8,12,0">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,12" BackgroundColor="White"
                            StrokeThickness="0">
                        <Border.Shadow>
                            <Shadow Brush="Black" Opacity="0.12" Radius="8"/>
                        </Border.Shadow>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16"/>
                        </Border.StrokeShape>

                        <Grid RowDefinitions="Auto,Auto">

                            <!-- Ảnh bìa -->
                            <Grid Grid.Row="0" HeightRequest="160">
                                <Image Source="{Binding CoverImage}"
                                       Aspect="AspectFill" HeightRequest="160"/>
                                <BoxView BackgroundColor="#99000000"
                                         VerticalOptions="End" HeightRequest="60"/>
                                <!-- Category badge -->
                                <Border BackgroundColor="{Binding CategoryColor}"
                                        Padding="8,4" StrokeThickness="0"
                                        HorizontalOptions="Start"
                                        VerticalOptions="Start"
                                        Margin="10,10,0,0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="20"/>
                                    </Border.StrokeShape>
                                    <Label Text="{Binding CategoryLabel}"
                                           TextColor="White" FontSize="11"
                                           FontAttributes="Bold"/>
                                </Border>
                                <!-- Distance badge -->
                                <Border BackgroundColor="#CC1A237E"
                                        Padding="8,4" StrokeThickness="0"
                                        HorizontalOptions="End"
                                        VerticalOptions="Start"
                                        Margin="0,10,10,0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="20"/>
                                    </Border.StrokeShape>
                                    <Label Text="{Binding DistanceText}"
                                           TextColor="White" FontSize="11"/>
                                </Border>
                            </Grid>

                            <!-- Info -->
                            <Grid Grid.Row="1" Padding="14,10,14,12"
                                  ColumnDefinitions="Auto,*,Auto">
                                <Border Grid.Column="0" BackgroundColor="#E8EAF6"
                                        WidthRequest="44" HeightRequest="44"
                                        StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12"/>
                                    </Border.StrokeShape>
                                    <Label Text="{Binding CategoryEmoji}" FontSize="22"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"/>
                                </Border>

                                <VerticalStackLayout Grid.Column="1" Margin="10,0"
                                                     VerticalOptions="Center">
                                    <Label Text="{Binding LocalizedName}"
                                           FontAttributes="Bold" FontSize="15"
                                           TextColor="#1A237E"/>
                                    <Label Text="{Binding LocalizedDescription}"
                                           FontSize="12" TextColor="#888"
                                           MaxLines="2"
                                           LineBreakMode="TailTruncation"/>
                                </VerticalStackLayout>

                                <Button Grid.Column="2" Text="🧭"
                                        BackgroundColor="#1A237E" TextColor="White"
                                        FontSize="18" WidthRequest="46" HeightRequest="46"
                                        CornerRadius="23" Padding="0"
                                        Clicked="OnNavigateClicked"
                                        CommandParameter="{Binding .}"/>
                            </Grid>
                        </Grid>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPoiTapped"
                                                  CommandParameter="{Binding .}"/>
                        </Border.GestureRecognizers>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>