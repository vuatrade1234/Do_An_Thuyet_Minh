<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VinhKhanhTour.Views.PoiDetailPage"
             BackgroundColor="#F5F7FA"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*,Auto">

        <!-- Content (Tràn viền lên trên cùng) -->
        <ScrollView Grid.Row="0" Margin="0" Padding="0,0,0,20">
            <VerticalStackLayout Spacing="0">

                <!-- Ảnh bìa Immersive Edge-to-Edge -->
                <Grid HeightRequest="380">
                    <Image x:Name="CoverImg"
                           Aspect="AspectFill" HeightRequest="380"/>
                    
                    <!-- Blur gradient ở trên cùng cho Header buttons (để dễ nhìn nút ←, 🧭) -->
                    <BoxView VerticalOptions="Start" HeightRequest="100">
                        <BoxView.Background>
                            <LinearGradientBrush EndPoint="0,1">
                                <GradientStop Color="#80000000" Offset="0.0" />
                                <GradientStop Color="Transparent" Offset="1.0" />
                            </LinearGradientBrush>
                        </BoxView.Background>
                    </BoxView>

                    <!-- Blur gradient ở đáy cho Text (để dễ nhìn tên POI) -->
                    <BoxView VerticalOptions="End" HeightRequest="180">
                        <BoxView.Background>
                            <LinearGradientBrush EndPoint="0,1">
                                <GradientStop Color="Transparent" Offset="0.0" />
                                <GradientStop Color="#CC000000" Offset="1.0" />
                            </LinearGradientBrush>
                        </BoxView.Background>
                    </BoxView>

                    <!-- Header nổi đè lên ảnh -->
                    <Grid VerticalOptions="Start" Padding="16,36,16,16"
                          ColumnDefinitions="Auto,*,Auto">
                        <Button Grid.Column="0" Text="←"
                                Clicked="OnBackClicked"
                                BackgroundColor="#40000000" TextColor="White"
                                FontSize="20" WidthRequest="44" HeightRequest="44" CornerRadius="22" Padding="0"/>
                        <!-- Thêm LblTitle ẩn để không bị lỗi CS0103 trong file .cs cũ -->
                        <Label x:Name="LblTitle" Grid.Column="1" IsVisible="False" />
                        <!-- Ẩn chữ Chi tiết POI đi cho giống trải nghiệm tạp chí tự nhiên -->
                        <Button Grid.Column="2" x:Name="BtnNavigateHeader"
                                Text="🧭"
                                Clicked="OnNavigateClicked"
                                BackgroundColor="#FFFFFF" TextColor="#1A237E"
                                FontSize="20" WidthRequest="46" HeightRequest="46" CornerRadius="23" Padding="0">
                            <Button.Shadow>
                                <Shadow Brush="Black" Opacity="0.15" Radius="8" Offset="0,4"/>
                            </Button.Shadow>
                        </Button>
                    </Grid>

                    <!-- Tên POI nằm chìm cực đẹp cuối ảnh -->
                    <VerticalStackLayout VerticalOptions="End"
                                         Padding="20,0,20,32">
                        <HorizontalStackLayout Spacing="6" Margin="0,0,0,10">
                            <Border BackgroundColor="#E6FFFFFF"
                                    Padding="10,6" StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12"/>
                                </Border.StrokeShape>
                                <HorizontalStackLayout Spacing="6">
                                    <Label x:Name="LblCategoryEmoji"
                                           FontSize="15" VerticalOptions="Center"/>
                                    <Label x:Name="LblCategoryLabel"
                                           FontSize="13" TextColor="#1A237E" FontAttributes="Bold"
                                           VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                            </Border>
                        </HorizontalStackLayout>

                        <Label x:Name="LblPoiName"
                               FontSize="26" FontAttributes="Bold"
                               TextColor="White"
                               LineBreakMode="WordWrap"/>
                    </VerticalStackLayout>
                </Grid>

                <!-- Stats: khoảng cách + bán kính -->
                <!-- SỬA LỖI MAUI CRASH: Dùng TranslationY="-20" thay vì Margin âm trên VerticalStackLayout -->
                <Grid ColumnDefinitions="*,*" Margin="16,0,16,0" TranslationY="-20"
                      ColumnSpacing="16">
                    <Border Grid.Column="0" BackgroundColor="White"
                            Padding="16,16" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="Black" Opacity="0.08" Radius="10" Offset="0,4"/>
                        </Border.Shadow>
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="6">
                            <Label x:Name="LblDistanceTitle"
                                   Text="📏 Khoảng cách"
                                   FontSize="12" TextColor="#78909C"
                                   HorizontalOptions="Center"/>
                            <Label x:Name="LblDistance"
                                   Text="--m"
                                   FontSize="22" FontAttributes="Bold"
                                   TextColor="#E65100"
                                   HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="1" BackgroundColor="White"
                            Padding="16,16" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="Black" Opacity="0.08" Radius="10" Offset="0,4"/>
                        </Border.Shadow>
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="6">
                            <Label x:Name="LblRadiusTitle"
                                   Text="🎯 Vùng kích hoạt"
                                   FontSize="12" TextColor="#78909C"
                                   HorizontalOptions="Center"/>
                            <Label x:Name="LblRadius"
                                   Text="30m"
                                   FontSize="22" FontAttributes="Bold"
                                   TextColor="#E65100"
                                   HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Giới thiệu -->
                <VerticalStackLayout Margin="20,28,20,0" Spacing="12">
                    <Label x:Name="LblIntroTitle"
                           Text="Chi tiết giới thiệu"
                           FontSize="18" FontAttributes="Bold"
                           TextColor="#1A237E"/>
                    <Border BackgroundColor="White" Padding="18,20"
                            StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="Black" Opacity="0.04" Radius="6"/>
                        </Border.Shadow>
                        <Label x:Name="LblDescription"
                               FontSize="14" TextColor="#455A64"
                               LineHeight="1.7"/>
                    </Border>
                </VerticalStackLayout>

                <!-- Nội dung thuyết minh (Dạng Quote cách điệu) -->
                <VerticalStackLayout Margin="20,24,20,24" Spacing="12">
                    <Label x:Name="LblTtsTitle"
                           Text="🎙 Nội dung thuyết minh"
                           FontSize="18" FontAttributes="Bold"
                           TextColor="#1A237E"/>
                    <Border BackgroundColor="#FDFBF7" Padding="20,20,20,24"
                            StrokeThickness="1">
                        <Border.Stroke>
                            <SolidColorBrush Color="#F0E6D2"/>
                        </Border.Stroke>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="8">
                            <Label Text="&quot;" FontSize="32" TextColor="#FFB300" FontAttributes="Bold" HeightRequest="20" TranslationY="-10"/>
                            <Label x:Name="LblTtsScript"
                                   FontSize="14" TextColor="#5D4037"
                                   FontAttributes="Italic"
                                   LineHeight="1.8"/>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom buttons (Thiết kế tràn viền mượt dưới cùng) -->
        <Border Grid.Row="1" BackgroundColor="White" StrokeThickness="0"
                Padding="20,16,20,28" Margin="0">
            <Border.Shadow>
                <Shadow Brush="Black" Opacity="0.08" Radius="12" Offset="0,-4"/>
            </Border.Shadow>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Grid.Column="0" x:Name="BtnBackMap"
                        Text="🗺 Bản đồ"
                        Clicked="OnBackMapClicked"
                        BackgroundColor="#F5F7FA" TextColor="#1A237E"
                        FontSize="14" FontAttributes="Bold"
                        HeightRequest="56" CornerRadius="16"/>
                <Button Grid.Column="1" x:Name="BtnListen"
                        Text="🎧 Nghe TTS"
                        Clicked="OnListenClicked"
                        BackgroundColor="#E65100" TextColor="White"
                        FontSize="14" FontAttributes="Bold"
                        HeightRequest="56" CornerRadius="16">
                    <Button.Shadow>
                        <Shadow Brush="#E65100" Opacity="0.3" Radius="8" Offset="0,4"/>
                    </Button.Shadow>
                </Button>
            </Grid>
        </Border>

    </Grid>
</ContentPage>