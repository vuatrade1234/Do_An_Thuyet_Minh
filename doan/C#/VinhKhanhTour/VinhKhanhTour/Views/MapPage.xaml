<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VinhKhanhTour.Views.MapPage"
             Title="🍜 Phố Vĩnh Khánh"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">

        <!-- Header -->
        <Grid Grid.Row="0" BackgroundColor="#1A237E" Padding="10,8"
              ColumnDefinitions="*,Auto,Auto">
            <Label Grid.Column="0" Text="{Binding StatusText}"
                   TextColor="White" FontSize="12" VerticalOptions="Center"
                   LineBreakMode="TailTruncation"/>
            <Button Grid.Column="1"
                    x:Name="BtnLangHeader"
                    Text="{Binding SelectedLanguage}"
                    Clicked="OnToggleLanguageClicked"
                    BackgroundColor="#DA251D"
                    TextColor="White"
                    FontSize="11" Padding="8,4" Margin="4,0" CornerRadius="6"/>
            <Button Grid.Column="2"
                    Text="{Binding StartStopText}"
                    Clicked="OnStartClicked"
                    BackgroundColor="#283593" TextColor="White"
                    FontSize="11" Padding="8,4" CornerRadius="6"/>
        </Grid>

        <Grid Grid.Row="1">

            <!-- Map WebView -->
            <WebView x:Name="MapWebView"
                     Navigated="OnMapNavigated"
                     Navigating="OnWebViewNavigating"/>

            <!-- D-pad góc trái dưới -->
            <Grid WidthRequest="126" HeightRequest="126"
                  HorizontalOptions="Start" VerticalOptions="End"
                  Margin="12,0,0,320"
                  RowDefinitions="40,40,40"
                  ColumnDefinitions="40,40,40"
                  RowSpacing="3" ColumnSpacing="3">
                <Button Grid.Row="0" Grid.Column="1" Text="▲"
                        FontSize="15" CornerRadius="8" Padding="0"
                        BackgroundColor="#CC1A237E" TextColor="White"
                        HeightRequest="40" WidthRequest="40"
                        Clicked="OnMoveUp"/>
                <Button Grid.Row="1" Grid.Column="0" Text="◀"
                        FontSize="15" CornerRadius="8" Padding="0"
                        BackgroundColor="#CC1A237E" TextColor="White"
                        HeightRequest="40" WidthRequest="40"
                        Clicked="OnMoveLeft"/>
                <Button Grid.Row="1" Grid.Column="1" Text="●"
                        FontSize="13" CornerRadius="20" Padding="0"
                        BackgroundColor="#CC283593" TextColor="White"
                        HeightRequest="40" WidthRequest="40"
                        Clicked="OnMoveReset"/>
                <Button Grid.Row="1" Grid.Column="2" Text="▶"
                        FontSize="15" CornerRadius="8" Padding="0"
                        BackgroundColor="#CC1A237E" TextColor="White"
                        HeightRequest="40" WidthRequest="40"
                        Clicked="OnMoveRight"/>
                <Button Grid.Row="2" Grid.Column="1" Text="▼"
                        FontSize="15" CornerRadius="8" Padding="0"
                        BackgroundColor="#CC1A237E" TextColor="White"
                        HeightRequest="40" WidthRequest="40"
                        Clicked="OnMoveDown"/>
            </Grid>

            <!-- Zoom + My Location góc phải dưới -->
            <VerticalStackLayout HorizontalOptions="End" VerticalOptions="End"
                                 Margin="0,0,12,320" Spacing="8">
                <Button Text="＋" Clicked="OnZoomInClicked"
                        WidthRequest="44" HeightRequest="44"
                        CornerRadius="22" BackgroundColor="White"
                        TextColor="#1A237E" FontSize="22" Padding="0">
                    <Button.Shadow>
                        <Shadow Brush="Black" Opacity="0.2" Radius="6"/>
                    </Button.Shadow>
                </Button>
                <Button Text="－" Clicked="OnZoomOutClicked"
                        WidthRequest="44" HeightRequest="44"
                        CornerRadius="22" BackgroundColor="White"
                        TextColor="#1A237E" FontSize="22" Padding="0">
                    <Button.Shadow>
                        <Shadow Brush="Black" Opacity="0.2" Radius="6"/>
                    </Button.Shadow>
                </Button>
                <Button Text="🎯" Clicked="OnMyLocationClicked"
                        WidthRequest="48" HeightRequest="48"
                        CornerRadius="24" BackgroundColor="#1A237E"
                        TextColor="White" FontSize="22" Padding="0">
                    <Button.Shadow>
                        <Shadow Brush="Black" Opacity="0.3" Radius="8"/>
                    </Button.Shadow>
                </Button>
            </VerticalStackLayout>

            <!-- Bottom Panel: Google Maps Style Bottom Sheet -->
            <Border VerticalOptions="End" HorizontalOptions="Fill"
                    Margin="0,0,0,0" BackgroundColor="White"
                    StrokeThickness="0">
                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.15" Radius="16" Offset="0,-4"/>
                </Border.Shadow>
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24,24,0,0"/>
                </Border.StrokeShape>

                <VerticalStackLayout Padding="16,12,16,24" Spacing="4">

                    <!-- Drag Handle (Thanh kéo ảo) -->
                    <BoxView HeightRequest="4" WidthRequest="40" BackgroundColor="#E0E0E0" 
                             CornerRadius="2" HorizontalOptions="Center" Margin="0,0,0,16"/>

                    <!-- Nút huỷ chỉ đường (hiện khi đang chỉ đường) -->
                    <Button x:Name="CancelRouteBtn"
                            Text="✕ Huỷ chỉ đường"
                            Clicked="OnCancelRouteClicked"
                            BackgroundColor="#FFEBEE" TextColor="#D32F2F"
                            FontSize="14" FontAttributes="Bold"
                            HeightRequest="40" CornerRadius="20" Padding="16,0"
                            HorizontalOptions="Start" Margin="0,0,0,8"
                            IsVisible="False"/>

                    <!-- Banner không có POI -->
                    <Border x:Name="NoPOIBanner"
                            BackgroundColor="#F8F9FA" Padding="16,12"
                            StrokeThickness="0" IsVisible="True" Margin="0,0,0,8">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                            <Label Text="📡" FontSize="18" VerticalOptions="Center"/>
                            <Label x:Name="LblNoPoi"
                                   Text="Kéo bản đồ để tìm điểm tham quan quanh đây"
                                   FontSize="14" TextColor="#5F6368"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Border>

                    <!-- POI info panel (Google Maps Style) -->
                    <!-- Lưu ý: Giữ x:Name="PoiInfoGrid" để code C# cũ vẫn truy xuất được -->
                    <VerticalStackLayout x:Name="PoiInfoGrid" IsVisible="False" Spacing="4">
                        <Grid ColumnDefinitions="*,Auto">
                            <!-- Title -->
                            <Label Grid.Column="0" Text="{Binding SelectedPoi.LocalizedName}" 
                                   FontAttributes="Bold" FontSize="22" TextColor="#202124" 
                                   LineBreakMode="TailTruncation" Margin="0,0,8,0" VerticalOptions="Center"/>
                            
                            <!-- Close Button -->
                            <Border Grid.Column="1" HorizontalOptions="End" VerticalOptions="Center" 
                                    WidthRequest="32" HeightRequest="32" StrokeThickness="0" BackgroundColor="#F1F3F4">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16"/>
                                </Border.StrokeShape>
                                <Label Text="✕" FontSize="16" FontAttributes="Bold" TextColor="#5F6368"
                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnClosePoiPanelClicked" />
                                </Border.GestureRecognizers>
                            </Border>
                        </Grid>

                        <!-- Rating & Distance -->
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center" Margin="0,4,0,0">
                            <Label Text="4.8" FontSize="14" TextColor="#3C4043" FontAttributes="Bold"/>
                            <Label Text="★★★★★" FontSize="14" TextColor="#F4B400"/>
                            <Label Text="(6.436)" FontSize="14" TextColor="#70757A"/>
                            <Label Text="·" FontSize="14" TextColor="#70757A"/>
                            <Label Text="🚶" FontSize="14" TextColor="#70757A"/>
                            <Label Text="{Binding SelectedPoi.DistanceText}" FontSize="14" TextColor="#70757A"/>
                        </HorizontalStackLayout>

                        <!-- Subtitle / Category -->
                        <HorizontalStackLayout Spacing="6" Margin="0,2,0,16">
                            <Label x:Name="LblPoiSubtitle" Text="Điểm tham quan địa phương" FontSize="14" TextColor="#70757A"/>
                            <Label Text="·" FontSize="14" TextColor="#70757A"/>
                            <Label Text="{Binding SelectedPoiEmoji}" FontSize="14"/>
                        </HorizontalStackLayout>

                        <!-- Hình ảnh thực tế của POI -->
                        <Border StrokeThickness="0" BackgroundColor="#E8EAF6" HeightRequest="120" Margin="0,0,0,8">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Image Source="{Binding SelectedPoi.CoverImage}" Aspect="AspectFill" HeightRequest="120" />
                        </Border>

                        <!-- Action Buttons -->
                        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                            <HorizontalStackLayout Spacing="8">
                                <Button x:Name="BtnRoute" Text="🧭 Đường đi" Clicked="OnDirectionClicked" 
                                        BackgroundColor="#0B57D0" TextColor="White" 
                                        FontSize="14" HeightRequest="38" CornerRadius="19" Padding="16,0" FontAttributes="Bold"/>
                                        
                                <Button x:Name="BtnDetail" Text="› Chi tiết" Clicked="OnPoiDetailClicked" 
                                        BackgroundColor="#F1F3F4" TextColor="#001D35" 
                                        FontSize="14" HeightRequest="38" CornerRadius="19" Padding="16,0" FontAttributes="Bold"/>
                                        
                                <Button x:Name="BtnAudio" Text="🎧 Thuyết minh" Clicked="OnPoiDetailClicked" 
                                        BackgroundColor="#F1F3F4" TextColor="#001D35" 
                                        FontSize="14" HeightRequest="38" CornerRadius="19" Padding="16,0" FontAttributes="Bold"/>
                            </HorizontalStackLayout>
                        </ScrollView>
                    </VerticalStackLayout>

                    <!-- Index POI Label ẩn giữ chức năng -->
                    <Label x:Name="PoiIndexLabel"
                           Text="{Binding PoiIndexText}"
                           IsVisible="False" HeightRequest="0"/>

                </VerticalStackLayout>
            </Border>

        </Grid>
    </Grid>
</ContentPage>
