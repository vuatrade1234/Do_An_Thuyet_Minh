<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VinhKhanhTour.Views.SettingsPage"
             Title="⚙️ Cài đặt"
             BackgroundColor="#F0F4FF">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <!-- TTS -->
            <Label Text="🎙 Text-to-Speech" FontSize="16"
                   FontAttributes="Bold" TextColor="#1A237E"/>
            <Border BackgroundColor="White" Padding="16" StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Tự động thuyết minh"
                               FontSize="14" VerticalOptions="Center"/>
                        <Switch Grid.Column="1" x:Name="AutoSpeakSwitch"
                                IsToggled="True" OnColor="#1A237E"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Âm lượng"
                               FontSize="14" VerticalOptions="Center"/>
                        <Label Grid.Column="1" x:Name="LblVolume"
                               Text="100%" FontSize="13" TextColor="#1A237E"/>
                    </Grid>
                    <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="100"
                            ThumbColor="#1A237E" MinimumTrackColor="#1A237E"
                            ValueChanged="OnVolumeChanged"/>
                    <Button Text="▶ Thử TTS" BackgroundColor="#1A237E"
                            TextColor="White" CornerRadius="10" HeightRequest="44"
                            Clicked="OnTestTtsClicked"/>
                </VerticalStackLayout>
            </Border>

            <!-- Số lần đọc lại -->
            <Label Text="🔁 Số lần đọc lại" FontSize="16"
                   FontAttributes="Bold" TextColor="#1A237E"/>
            <Border BackgroundColor="White" Padding="16" StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Số lần đọc mỗi POI"
                               FontSize="14" VerticalOptions="Center"/>
                        <Border Grid.Column="1" BackgroundColor="#E8EAF6"
                                Padding="12,6" StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8"/>
                            </Border.StrokeShape>
                            <Label x:Name="LblRepeat" Text="1 lần"
                                   FontSize="14" FontAttributes="Bold" TextColor="#1A237E"/>
                        </Border>
                    </Grid>
                    <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="6">
                        <Button x:Name="BtnR1" Grid.Column="0" Text="1x"
                                CornerRadius="8" FontSize="12" HeightRequest="36"
                                BackgroundColor="#1A237E" TextColor="White"
                                Clicked="OnRepeat1Clicked"/>
                        <Button x:Name="BtnR2" Grid.Column="1" Text="2x"
                                CornerRadius="8" FontSize="12" HeightRequest="36"
                                BackgroundColor="#E8EAF6" TextColor="#1A237E"
                                Clicked="OnRepeat2Clicked"/>
                        <Button x:Name="BtnR3" Grid.Column="2" Text="3x"
                                CornerRadius="8" FontSize="12" HeightRequest="36"
                                BackgroundColor="#E8EAF6" TextColor="#1A237E"
                                Clicked="OnRepeat3Clicked"/>
                        <Button x:Name="BtnR4" Grid.Column="3" Text="4x"
                                CornerRadius="8" FontSize="12" HeightRequest="36"
                                BackgroundColor="#E8EAF6" TextColor="#1A237E"
                                Clicked="OnRepeat4Clicked"/>
                        <Button x:Name="BtnR5" Grid.Column="4" Text="5x"
                                CornerRadius="8" FontSize="12" HeightRequest="36"
                                BackgroundColor="#E8EAF6" TextColor="#1A237E"
                                Clicked="OnRepeat5Clicked"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Thời gian chờ -->
            <Label Text="⏱ Thời gian chờ giữa POI" FontSize="16"
                   FontAttributes="Bold" TextColor="#1A237E"/>
            <Border BackgroundColor="White" Padding="16" StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Cooldown sau khi đọc xong"
                               FontSize="14" VerticalOptions="Center"/>
                        <Border Grid.Column="1" BackgroundColor="#E8EAF6"
                                Padding="12,6" StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8"/>
                            </Border.StrokeShape>
                            <Label x:Name="LblCooldown" Text="60s"
                                   FontSize="14" FontAttributes="Bold" TextColor="#1A237E"/>
                        </Border>
                    </Grid>
                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
                        <Button x:Name="BtnC10" Grid.Column="0" Text="10s"
                                CornerRadius="8" FontSize="12" HeightRequest="36"
                                BackgroundColor="#E8EAF6" TextColor="#1A237E"
                                Clicked="OnCooldown10Clicked"/>
                        <Button x:Name="BtnC30" Grid.Column="1" Text="30s"
                                CornerRadius="8" FontSize="12" HeightRequest="36"
                                BackgroundColor="#E8EAF6" TextColor="#1A237E"
                                Clicked="OnCooldown30Clicked"/>
                        <Button x:Name="BtnC60" Grid.Column="2" Text="60s"
                                CornerRadius="8" FontSize="12" HeightRequest="36"
                                BackgroundColor="#1A237E" TextColor="White"
                                Clicked="OnCooldown60Clicked"/>
                        <Button x:Name="BtnC120" Grid.Column="3" Text="120s"
                                CornerRadius="8" FontSize="12" HeightRequest="36"
                                BackgroundColor="#E8EAF6" TextColor="#1A237E"
                                Clicked="OnCooldown120Clicked"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Bán kính -->
            <Label Text="📡 Bán kính kích hoạt" FontSize="16"
                   FontAttributes="Bold" TextColor="#1A237E"/>
            <Border BackgroundColor="White" Padding="16" StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Bán kính đọc thuyết minh"
                               FontSize="14" VerticalOptions="Center"/>
                        <Border Grid.Column="1" BackgroundColor="#E8EAF6"
                                Padding="12,6" StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8"/>
                            </Border.StrokeShape>
                            <Label x:Name="LblRadius" Text="30m"
                                   FontSize="14" FontAttributes="Bold" TextColor="#1A237E"/>
                        </Border>
                    </Grid>
                    <Slider x:Name="RadiusSlider" Minimum="10" Maximum="100" Value="30"
                            ThumbColor="#1A237E" MinimumTrackColor="#1A237E"
                            ValueChanged="OnRadiusChanged"/>
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                        <Button x:Name="BtnRad10" Grid.Column="0" Text="10m"
                                CornerRadius="8" FontSize="12" HeightRequest="36"
                                BackgroundColor="#E8EAF6" TextColor="#1A237E"
                                Clicked="OnRadius10Clicked"/>
                        <Button x:Name="BtnRad30" Grid.Column="1" Text="30m"
                                CornerRadius="8" FontSize="12" HeightRequest="36"
                                BackgroundColor="#1A237E" TextColor="White"
                                Clicked="OnRadius30Clicked"/>
                        <Button x:Name="BtnRad50" Grid.Column="2" Text="50m"
                                CornerRadius="8" FontSize="12" HeightRequest="36"
                                BackgroundColor="#E8EAF6" TextColor="#1A237E"
                                Clicked="OnRadius50Clicked"/>
                    </Grid>
                    <Label Text="💡 2 POI giao nhau → ưu tiên gần nhất&#10;   Ra khỏi bán kính → dừng đọc ngay"
                           FontSize="11" TextColor="#999" LineHeight="1.5"/>
                </VerticalStackLayout>
            </Border>

            <!-- Ngôn ngữ -->
            <Label Text="🌐 Ngôn ngữ" FontSize="16"
                   FontAttributes="Bold" TextColor="#1A237E"/>
            <Border BackgroundColor="White" Padding="16" StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14"/>
                </Border.StrokeShape>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Button x:Name="BtnVi" Grid.Column="0" Text="🇻🇳 Tiếng Việt"
                            BackgroundColor="#1A237E" TextColor="White"
                            CornerRadius="10" HeightRequest="44"
                            Clicked="OnViClicked"/>
                    <Button x:Name="BtnEn" Grid.Column="1" Text="🇬🇧 English"
                            BackgroundColor="#E8EAF6" TextColor="#1A237E"
                            CornerRadius="10" HeightRequest="44"
                            Clicked="OnEnClicked"/>
                </Grid>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>