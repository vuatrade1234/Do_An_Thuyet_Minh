<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VinhKhanhTour.DetailsPage" Title="Chi tiết &amp; Menu">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Border StrokeShape="RoundRectangle 15" HeightRequest="200">
                <Image x:Name="imgPOI" Aspect="AspectFill" Source="dotnet_bot.png"/>
            </Border>
            <Label x:Name="lblTitle" FontSize="24" FontAttributes="Bold" TextColor="#E44D26" HorizontalOptions="Center"/>
            <Border StrokeShape="RoundRectangle 10" BackgroundColor="#FFF3E0" Padding="15">
                <Label x:Name="lblMenu" FontSize="16" FontAttributes="Italic" />
            </Border>
            <Button Text="🔊 NGHE LẠI MENU" Clicked="OnReplayMenu" BackgroundColor="#E44D26" CornerRadius="20"/>
            <Button Text="QUAY LẠI" Clicked="OnBackClicked" BackgroundColor="Gray" CornerRadius="20"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>