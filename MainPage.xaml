<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VinhKhanhTour.MainPage"
             Title="Vĩnh Khánh Food Street ">

    <Grid RowDefinitions="*, Auto">
        <WebView x:Name="mapRadar" Grid.Row="0" />

        <!-- Ảnh mini ở góc trái bản đồ -->
        <Border x:Name="imgPopupBorder" Grid.Row="0" HorizontalOptions="Start" VerticalOptions="Start" 
                Margin="15,15,0,0" WidthRequest="120" HeightRequest="120" 
                StrokeShape="RoundRectangle 15" IsVisible="False" StrokeThickness="2" Stroke="White">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,2" Radius="5" Opacity="0.5" />
            </Border.Shadow>
            <Image x:Name="imgPopup" Aspect="AspectFill" />
        </Border>

        <Border Grid.Row="1" Margin="10" Padding="15" StrokeShape="RoundRectangle 15" BackgroundColor="White">
            <VerticalStackLayout Spacing="10">
                <Label x:Name="lblTenQuan" Text="Đang tìm quán..." FontSize="18" FontAttributes="Bold" TextColor="#E44D26" HorizontalOptions="Center"/>
                <Label x:Name="lblDistance" Text="Cách: --m" HorizontalOptions="Center" TextColor="Gray"/>

                <Grid ColumnDefinitions="*, *, *" RowDefinitions="Auto, Auto" HorizontalOptions="Center" WidthRequest="210">
                    <Button Text="↑" Clicked="MoveUp" Grid.Row="0" Grid.Column="1" BackgroundColor="#E44D26" Margin="3" HeightRequest="45"/>
                    <Button Text="←" Clicked="MoveLeft" Grid.Row="1" Grid.Column="0" BackgroundColor="#E44D26" Margin="3" HeightRequest="45"/>
                    <Button Text="↓" Clicked="MoveDown" Grid.Row="1" Grid.Column="1" BackgroundColor="#E44D26" Margin="3" HeightRequest="45"/>
                    <Button Text="→" Clicked="MoveRight" Grid.Row="1" Grid.Column="2" BackgroundColor="#E44D26" Margin="3" HeightRequest="45"/>
                </Grid>

                <Button Text="XEM CHI TIẾT &amp; MENU" Clicked="OnShowDetailsTapped" 
                        BackgroundColor="#2196F3" CornerRadius="20" FontAttributes="Bold" Margin="0,5,0,0"/>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
