<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GPSNarrationApp.MainPage"
             Title="GPS Narration App">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label Text="Ứng dụng thuyết minh GPS"
                   FontSize="24"
                   HorizontalOptions="Center"
                   FontAttributes="Bold"/>

            <Label Text="Vị trí hiện tại:"
                   FontSize="16"/>

            <Label x:Name="LocationLabel"
                   Text="Chưa lấy vị trí"
                   TextColor="Blue"/>

            <Label Text="Chọn ngôn ngữ:"/>

            <Picker x:Name="LanguagePicker">
                <Picker.Items>
                    <x:String>Tiếng Việt</x:String>
                    <x:String>English</x:String>
                </Picker.Items>
            </Picker>

            <Button Text="Lấy vị trí GPS"
                    Clicked="OnGetLocationClicked"/>

            <Button Text="Thuyết minh"
                    BackgroundColor="Green"
                    TextColor="White"
                    Clicked="OnNarrateClicked"/>

            <Label Text="Nội dung thuyết minh:"
                   FontAttributes="Bold"/>

            <Label x:Name="NarrationLabel"
                   Text="---"
                   TextColor="DarkRed"
                   FontSize="16"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
